CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_MAIN_TASK_STACK_SIZE=16384

# Enable octal PSRAM (8 MB on this ESP32-S3 N16R8 chip)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Route large heap allocations (>= 512 B) to PSRAM automatically
CONFIG_SPIRAM_USE_MALLOC=y

# Custom partition table (3 MB app slot for 16 MB flash)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Task Watchdog: increase timeout to survive multi-step HTTP syncs.
# Default 5 s is too short — weather sync makes up to 3 sequential HTTP
# requests each with an 8 s timeout (total ≤ 24 s).  30 s gives headroom
# while still catching genuine hard-locks.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# WiFi credentials — override in a local sdkconfig or via idf.py menuconfig
# NEVER commit real credentials here.
CONFIG_WIFI_SSID=""
CONFIG_WIFI_PASSWORD=""

# Voice backend URL — change to your machine's LAN IP
CONFIG_VOICE_API_URL="http://192.168.1.1:8000"
# Voice backend auth token — must match VOICE_API_TOKEN on the server
# Override locally; do not commit the real token.
CONFIG_VOICE_API_TOKEN=""
