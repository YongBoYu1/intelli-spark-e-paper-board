CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_MAIN_TASK_STACK_SIZE=16384

# Enable octal PSRAM (8 MB on this ESP32-S3 N16R8 chip)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Route large heap allocations (>= 512 B) to PSRAM automatically
CONFIG_SPIRAM_USE_MALLOC=y

# Custom partition table (3 MB app slot for 16 MB flash)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Task Watchdog: long enough to survive multi-step HTTP syncs including
# TCP connection establishment.
#
# Root cause of TG0WDT_SYS_RST:
#   cfg.timeout_ms (8 s) only sets SO_RCVTIMEO / SO_SNDTIMEO on the socket —
#   it does NOT limit the TCP SYN handshake phase.  lwIP default SYNMAXRTX=6
#   allows up to ~127 s of SYN retries per request × 3 requests ≫ any WDT.
#
# Two-part fix:
#   1. CONFIG_LWIP_TCP_SYNMAXRTX=3  →  max TCP connect time ≈ 15 s
#      (retries: 1+2+4+8 s, minimum allowed by ESP-IDF Kconfig range 3..12)
#   2. CONFIG_ESP_TASK_WDT_TIMEOUT_S=90  →  fits 3 × (15 s TCP + 8 s HTTP)
#      = 69 s worst-case (all 3 requests hang at both levels), with 21 s spare.
CONFIG_LWIP_TCP_SYNMAXRTX=3
CONFIG_ESP_TASK_WDT_TIMEOUT_S=90

# WiFi credentials — override in a local sdkconfig or via idf.py menuconfig
# NEVER commit real credentials here.
CONFIG_WIFI_SSID=""
CONFIG_WIFI_PASSWORD=""

# Voice backend URL — production Render deployment.
# For local dev, override in a local sdkconfig or via idf.py menuconfig.
CONFIG_VOICE_API_URL="https://e-board-voice-api.onrender.com"
# Voice backend auth token — must match VOICE_API_TOKEN on the server.
# Override locally; do not commit the real token.
CONFIG_VOICE_API_TOKEN=""

# HTTPS / TLS — enable the bundled Mozilla CA store so the voice backend
# (Render, Let's Encrypt cert) and any future HTTPS endpoints validate correctly.
# Uses ~77 KB of flash; negligible on the 16 MB chip.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
