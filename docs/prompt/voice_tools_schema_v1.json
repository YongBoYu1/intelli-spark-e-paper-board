{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice-tools-v1",
  "title": "Voice Tool Call",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "inventory_log_event" },
        "args": {
          "type": "object",
          "required": ["item_name", "event_type"],
          "properties": {
            "item_name": { "type": "string", "minLength": 1 },
            "event_type": { "type": "string", "enum": ["consumed", "used", "added", "restocked", "finished"] },
            "effective_date": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "inventory_set_expiry" },
        "args": {
          "type": "object",
          "required": ["item_name", "expiry_date"],
          "properties": {
            "item_name": { "type": "string", "minLength": 1 },
            "expiry_date": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "inventory_clear_all" },
        "args": {
          "type": "object",
          "properties": {
            "confirm_token": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "shopping_add_item" },
        "args": {
          "type": "object",
          "required": ["item_name"],
          "properties": {
            "item_name": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "shopping_remove_item" },
        "args": {
          "type": "object",
          "required": ["item_name"],
          "properties": {
            "item_name": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "shopping_clear_all" },
        "args": {
          "type": "object",
          "properties": {
            "confirm_token": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "timer_set" },
        "args": {
          "type": "object",
          "required": ["duration_seconds"],
          "properties": {
            "duration_seconds": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "memo_add" },
        "args": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "author": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "undo_last_action_group" },
        "args": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "redo_last_action_group" },
        "args": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {
        "tool": { "const": "no_action" },
        "args": {
          "type": "object",
          "required": ["reason"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  ]
}
